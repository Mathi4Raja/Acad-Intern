# Password Reset Configuration Example
# Add these variables to your existing .env file

# Required for password reset emails
# The URL of your frontend application (used in reset links)
FRONTEND_URL=http://localhost:3000

# Optional: Email Service Configuration
# Uncomment and configure ONE of the following options:

# Option 1: Resend (Recommended)
# Sign up at https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxx
# FROM_EMAIL=noreply@yourdomain.com

# Option 2: SMTP (e.g., Gmail, Outlook, etc.)
# For Gmail: Use App Password (not regular password)
# https://support.google.com/accounts/answer/185833
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your.email@gmail.com
# SMTP_PASSWORD=your_app_password
# FROM_EMAIL=noreply@yourdomain.com

# Note: In development mode (NODE_ENV=development),
# emails will be logged to console instead of being sent.
